datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           String          @default("STUDENT") // STUDENT, STAFF, ADMIN
  avatar         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  adminProfile   AdminProfile?

  bookings       Booking[]
  issues         Issue[]         @relation("ReportedIssues")
  assignedIssues Issue[]         @relation("AssignedIssues")
  issueComments  IssueComment[]
  notifications  Notification[]
  requests       EquipmentRequest[]
  lostFoundItems LostFoundItem[]
  announcements  Announcement[]  @relation("AuthorAnnouncements")
  feedbacks      Feedback[]
}

model StudentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registerNo String   @unique
  department String
  year       Int
  phone      String?
  college    String   @default("College of Engineering & Technology")
}

model StaffProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String   @unique
  department String
  phone      String?
  position   String   @default("Lab In-Charge")
}

model AdminProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String   @default("Campus Administration")
  phone      String?
}

model Lab {
  id           String             @id @default(uuid())
  name         String             @unique
  code         String             @unique
  category     String
  description  String
  location     String
  capacity     Int                @default(30)
  openingHours String             @default("08:00 AM - 08:00 PM")
  status       String             @default("OPERATIONAL")
  image        String?
  isAvailable  Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  equipments   Equipment[]
  bookings     Booking[]
  issues       Issue[]
  requests     EquipmentRequest[]
  locations    CampusLocation[]
}

model Equipment {
  id                  String    @id @default(uuid())
  name                String
  equipmentId         String    @unique
  category            String
  labId               String
  lab                 Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  manufacturer        String?
  model               String?
  description         String?
  specifications      String?
  status              String    @default("AVAILABLE") // AVAILABLE, BOOKED, IN_USE, MAINTENANCE, OUT_OF_SERVICE
  isAvailable         Boolean   @default(true)
  image               String?
  maintenanceSchedule String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bookings            Booking[]
  issues              Issue[]
}

model Booking {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  labId           String
  lab             Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  date            String
  startTime       String
  endTime         String
  purpose         String
  description     String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED, COMPLETED
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Issue {
  id              String   @id @default(uuid())
  issueNo         String   @unique
  userId          String
  user            User     @relation("ReportedIssues", fields: [userId], references: [id], onDelete: Cascade)
  labId           String?
  lab             Lab?     @relation(fields: [labId], references: [id], onDelete: SetNull)
  equipmentId     String?
  equipment       Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  title           String
  category        String
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  description     String
  imageUrl        String?
  resolutionNotes String?
  assignedStaffId String?
  assignedStaff   User?    @relation("AssignedIssues", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments        IssueComment[]
}

model IssueComment {
  id        String   @id @default(uuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model EquipmentRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId         String?
  lab           Lab?     @relation(fields: [labId], references: [id], onDelete: SetNull)
  equipmentName String
  category      String
  purpose       String
  status        String   @default("PENDING")
  response      String?
  createdAt     DateTime @default(now())
}

model LostFoundItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String
  description String
  location    String
  date        String
  status      String   @default("LOST") // LOST, FOUND, CLAIMED
  contactInfo String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Announcement {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("AuthorAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  category    String   @default("GENERAL")
  isImportant Boolean  @default(false)
  isPublished Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  rating    Int
  comments  String
  createdAt DateTime @default(now())
}

model CampusLocation {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  category    String
  lat         Float
  lng         Float
  floor       String   @default("1st Floor")
  labId       String?
  lab         Lab?     @relation(fields: [labId], references: [id], onDelete: SetNull)
  description String?
}
